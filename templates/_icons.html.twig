{#
    One icon grammar for the whole product: 24 viewBox, 1.5 stroke, round caps and
    joins, no fills. Drawn here rather than pulled from a set so the weight matches
    the hairline borders.
#}
{% macro icon(name, class = 'size-4') %}
    {%- set paths = {
        'logs': '<path d="M4 6h16M4 12h16M4 18h10"/>',
        'projects': '<path d="M3 7a2 2 0 0 1 2-2h3.6a2 2 0 0 1 1.4.6L11.5 7H19a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
        'key': '<circle cx="8" cy="12" r="3.2"/><path d="M11.2 12H21M18 12v3M15 12v2"/>',
        'settings': '<circle cx="12" cy="12" r="3"/><path d="M12 3v2.2M12 18.8V21M21 12h-2.2M5.2 12H3M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6M18.4 18.4l-1.6-1.6M7.2 7.2 5.6 5.6"/>',
        'search': '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.3-4.3"/>',
        'chevron-down': '<path d="m6 9 6 6 6-6"/>',
        'chevron-up': '<path d="m6 15 6-6 6 6"/>',
        'chevron-left': '<path d="m14 6-6 6 6 6"/>',
        'chevron-right': '<path d="m10 6 6 6-6 6"/>',
        'calendar': '<rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 9.5h17M8 3.5V6.5M16 3.5V6.5"/>',
        'refresh': '<path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20 4v4.5h-4.5"/>',
        'copy': '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M15 6.5A2.5 2.5 0 0 0 12.5 4H6a2 2 0 0 0-2 2v6.5A2.5 2.5 0 0 0 6.5 15"/>',
        'close': '<path d="m6 6 12 12M18 6 6 18"/>',
        'plus': '<path d="M12 5v14M5 12h14"/>',
        'minus': '<path d="M5 12h14"/>',
        'dots': '<circle cx="5.5" cy="12" r="1.2"/><circle cx="12" cy="12" r="1.2"/><circle cx="18.5" cy="12" r="1.2"/>',
        'column': '<rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M14 4.5v15"/>',
        'alert': '<path d="M12 8.5v4.5M12 16.4v.2"/><circle cx="12" cy="12" r="8.5"/>',
        'sign-out': '<path d="M15 5.5H18a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-3"/><path d="M11 8.5 14.5 12 11 15.5M14 12H4"/>',
        'inbox': '<path d="M3.5 13.5h4l1.5 3h6l1.5-3h4"/><path d="M6 5h12l3 8.5v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-3z"/>',
    } %}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ paths[name]|raw }}</svg>
{% endmacro %}
