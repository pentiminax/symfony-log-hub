{% import '_icons.html.twig' as ui %}

{#
    One key/value line of the detail drawer. `field` is the searchable path behind
    the value; passing null renders the row without the filter affordances, which is
    the honest thing to do for values the store cannot filter on.
#}
{% macro detail(label, value, field = null) %}
    {% import '_icons.html.twig' as ui %}
    {# Two columns only once there is room for two: below sm the label sits above its
       value, otherwise a 9rem label column leaves the value one character wide. #}
    <div class="group grid grid-cols-1 items-start gap-x-3 gap-y-0.5 border-b border-line/70 px-4 py-2
                sm:grid-cols-[minmax(9rem,14rem)_1fr] sm:px-5">
        <span class="truncate font-mono text-micro text-ink-muted" title="{{ label }}">{{ label }}</span>
        <span class="flex min-w-0 items-start gap-1">
            <span class="min-w-0 flex-1 font-mono break-words text-ink">{{ value }}</span>
            {# Always visible on touch: there is no hover to reveal them with. #}
            <span class="flex shrink-0 items-center gap-0.5 transition-opacity
                         sm:opacity-0 sm:group-hover:opacity-100 sm:focus-within:opacity-100">
                <button type="button" class="lh-row-action" title="Copy value"
                        {{ stimulus_controller('clipboard', { text: value }) }} data-action="clipboard#copy">
                    {{ ui.icon('copy', 'size-3.5') }}<span class="sr-only">Copy value</span>
                </button>
                {% if field %}
                    <button type="button" class="lh-row-action" title="Filter for this value"
                            data-action="live#action" data-live-action-param="addFilter"
                            data-live-field-param="{{ field }}" data-live-op-param="equals"
                            data-live-value-param="{{ value }}">
                        {{ ui.icon('plus', 'size-3.5') }}<span class="sr-only">Filter for this value</span>
                    </button>
                    <button type="button" class="lh-row-action" title="Filter out this value"
                            data-action="live#action" data-live-action-param="addFilter"
                            data-live-field-param="{{ field }}" data-live-op-param="not_equals"
                            data-live-value-param="{{ value }}">
                        {{ ui.icon('minus', 'size-3.5') }}<span class="sr-only">Filter out this value</span>
                    </button>
                    <button type="button" class="lh-row-action" title="Add as column"
                            data-action="live#action" data-live-action-param="addColumn"
                            data-live-column-param="{{ field }}">
                        {{ ui.icon('column', 'size-3.5') }}<span class="sr-only">Add as column</span>
                    </button>
                {% endif %}
            </span>
        </span>
    </div>
{% endmacro %}
