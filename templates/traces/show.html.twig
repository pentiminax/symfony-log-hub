{% extends 'app.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% macro value(v) -%}
    {%- if v is null -%}null
    {%- elseif v is same as(true) -%}true
    {%- elseif v is same as(false) -%}false
    {%- elseif v is iterable -%}{{ v|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}
    {%- else -%}{{ v }}{%- endif -%}
{%- endmacro %}

{% macro pairs(title, data) %}
    {% if data is not empty %}
        <h4 class="mt-3 mb-1 text-label font-medium text-ink-muted">{{ title }}</h4>
        <dl class="grid grid-cols-[minmax(8rem,16rem)_1fr] gap-x-4 gap-y-0.5 font-mono text-micro">
            {% for k, v in data %}
                <dt class="truncate text-ink-muted" title="{{ k }}">{{ k }}</dt>
                <dd class="break-all">{{ _self.value(v) }}</dd>
            {% endfor %}
        </dl>
    {% endif %}
{% endmacro %}

{% block title %}Trace {{ (trace.id ~ '')|slice(0, 8) }} · LogHub{% endblock %}

{% block content %}
{% set rows = trace.tree %}
{% set root = rows[0].span %}
<div class="flex min-h-0 flex-1 flex-col overflow-y-auto">
    <header class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 pt-4 pb-3 sm:px-6">
        <div class="mr-auto min-w-0">
            <p class="text-label"><a class="text-accent underline" href="{{ path('app_traces', { project: project.id ~ '' }) }}">&larr; Traces</a></p>
            <h1 class="truncate text-lg font-semibold tracking-tight">{{ root.name }}</h1>
            <p class="font-mono text-micro text-ink-muted">{{ trace.id }}</p>
        </div>
        <p class="tnum text-body text-ink-muted">
            {{ include('traces/_duration.html.twig', { ns: trace.durationUs * 1000 }) }} &middot;
            {{ trace.spans|length }} spans &middot;
            {{ trace.errorCount }} error{{ trace.errorCount != 1 ? 's' }}
        </p>
        <a class="lh-button" href="{{ path('app_logs', { project: project.id ~ '', range: '7d', f: [{ field: 'trace.id', op: 'equals', value: trace.id ~ '' }] }) }}">View logs for this trace</a>
    </header>

    <ol class="border-t border-line" aria-label="Spans of this trace">
        {% for row in rows %}
            {% set span = row.span %}
            {% set hue = trace.serviceHue(span.serviceName) %}
            <li class="border-b border-line">
                <details class="group">
                    <summary class="grid cursor-pointer grid-cols-[minmax(10rem,32%)_1fr_5.5rem] items-center gap-3 px-4 py-1.5 hover:bg-sunken sm:px-6
                                    {{ span.isError ? 'bg-error-tint' }}">
                        <span class="flex min-w-0 items-center gap-1.5" style="padding-left: {{ row.depth * 1.25 }}rem">
                            <span class="size-2 shrink-0 rounded-full" style="background-color: hsl({{ hue }} 55% 45%)" aria-hidden="true"></span>
                            <span class="truncate font-mono text-body" title="{{ span.name }}">{{ span.name }}</span>
                            <span class="shrink-0 text-micro text-ink-faint">{{ span.serviceName }}</span>
                            {% if span.isError %}<span class="shrink-0 text-micro font-medium text-error-ink">error</span>{% endif %}
                        </span>
                        <span class="relative block h-4 rounded-sm bg-sunken" role="img"
                              aria-label="{{ span.name }}: {{ include('traces/_duration.html.twig', { ns: span.durationNs }) }}, starts {{ include('traces/_duration.html.twig', { ns: (span.startUs - trace.startUs) * 1000 }) }} after the trace start{{ span.isError ? ', failed' }}">
                            <span class="absolute inset-y-0 rounded-sm {{ span.isError ? 'ring-2 ring-error-ink' }}"
                                  style="left: {{ trace.offsetPercent(span)|number_format(3, '.', '') }}%; width: {{ trace.widthPercent(span)|number_format(3, '.', '') }}%; background-color: {{ span.isError ? 'var(--color-error-ink, #b91c1c)' : 'hsl(' ~ hue ~ ' 55% 45%)' }}"></span>
                        </span>
                        <span class="tnum text-right text-body">{{ include('traces/_duration.html.twig', { ns: span.durationNs }) }}</span>
                    </summary>
                    <div class="bg-surface px-4 py-3 sm:px-6" style="padding-left: {{ 1.5 + row.depth * 1.25 }}rem">
                        {{ _self.pairs('Span', {
                            'span_id': span.spanId, 'parent_span_id': span.parentSpanId, 'kind': span.kind,
                            'status': span.status ~ (span.statusMessage ? ': ' ~ span.statusMessage : ''),
                            'service.name': span.serviceName, 'start': span.start|date('Y-m-d H:i:s.u'),
                        }) }}
                        {{ _self.pairs('Attributes', span.attributes) }}
                        {{ _self.pairs('Resource', span.resource) }}
                        {% for event in span.events %}
                            <h4 class="mt-3 mb-1 text-label font-medium text-ink-muted">Event: <span class="font-mono">{{ event.name }}</span>
                                {% if event.timestamp %}<span class="tnum font-normal">({{ event.timestamp }})</span>{% endif %}</h4>
                            {% for k, v in event.attributes %}
                                {% if k == 'exception.stacktrace' %}
                                    <pre class="max-h-96 overflow-auto rounded-control bg-sunken p-3 font-mono text-micro leading-relaxed text-ink-muted">{{ v }}</pre>
                                {% else %}
                                    {{ _self.pairs('', { (k): v }) }}
                                {% endif %}
                            {% endfor %}
                        {% endfor %}
                    </div>
                </details>
            </li>
        {% endfor %}
    </ol>
</div>
{% endblock %}
