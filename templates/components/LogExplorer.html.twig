{% import '_icons.html.twig' as ui %}

{% set project = this.currentProject %}

<div {{ attributes.defaults({ class: 'flex min-h-0 flex-1 flex-col' }) }}>

    <div data-live-error-target="banner" role="status" hidden
         class="flex items-center gap-2 bg-warn-tint px-4 py-2 text-body text-warn-ink sm:px-6">
        {{ ui.icon('alert', 'size-4 shrink-0') }}
        <span>Lost contact with the server. Showing the last results that loaded.</span>
    </div>

    {# --- Header ------------------------------------------------------------- #}
    <header class="flex flex-wrap items-center gap-3 px-4 pt-4 pb-3 sm:px-6">
        <h1 class="mr-auto text-lg font-semibold tracking-tight">Logs</h1>

        {% if this.projects|length > 1 %}
            <label class="sr-only" for="lh-project">Project</label>
            <select id="lh-project" class="lh-control pr-1.5" data-model="project">
                {% for item in this.projects %}
                    <option value="{{ item.id }}" {{ project and item.id == project.id ? 'selected' }}>{{ item.name }}</option>
                {% endfor %}
            </select>
        {% elseif project %}
            <span class="lh-control cursor-default text-ink-muted">{{ ui.icon('projects', 'size-3.5') }} {{ project.name }}</span>
        {% endif %}

        <label class="sr-only" for="lh-range">Time range</label>
        <select id="lh-range" class="lh-control pr-1.5" data-model="range">
            {% for preset in this.rangePresets %}
                <option value="{{ preset.value }}" {{ preset.value == range ? 'selected' }}>{{ preset.label }}</option>
            {% endfor %}
        </select>

        {% if range == 'custom' %}
            <input type="datetime-local" class="lh-control" data-model="debounce(500)|from" value="{{ from }}" aria-label="From">
            <input type="datetime-local" class="lh-control" data-model="debounce(500)|to" value="{{ to }}" aria-label="To">
        {% endif %}

        <label class="lh-control gap-1.5 pr-2.5" title="Auto-refresh">
            {{ ui.icon('refresh', 'size-3.5 shrink-0 text-ink-faint') }}
            <span class="sr-only">Auto-refresh</span>
            <select class="bg-transparent text-body outline-none" data-model="refreshMs">
                <option value="0">Off</option>
                <option value="5000">5s</option>
                <option value="15000">15s</option>
                <option value="60000">1m</option>
            </select>
        </label>
    </header>

    {# --- Search ------------------------------------------------------------- #}
    <div class="px-4 sm:px-6">
        <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-ink-faint">
                {{ ui.icon('search') }}
            </span>
            <input type="search" class="lh-input pl-9" data-model="debounce(400)|q" value="{{ q }}"
                   placeholder="Search messages…" aria-label="Search log messages">
        </div>
    </div>

    {# --- Filters ------------------------------------------------------------ #}
    <div class="flex flex-wrap items-center gap-2 px-4 py-3 sm:px-6">
        <label class="sr-only" for="lh-level">Level</label>
        <select id="lh-level" class="lh-control pr-1.5 {{ level ? 'border-accent-line bg-accent-tint' }}" data-model="level">
            <option value="">All levels</option>
            {% for item in this.levels %}
                <option value="{{ item.value }}" {{ item.value == level ? 'selected' }}>{{ item.label }}</option>
            {% endfor %}
        </select>

        {% for field, prop in { 'service.name': 'service', 'environment': 'env' } %}
            {% set values = this.facetValues(field) %}
            {% set current = prop == 'service' ? service : env %}
            <label class="sr-only" for="lh-{{ prop }}">{{ prop == 'service' ? 'Service' : 'Environment' }}</label>
            <select id="lh-{{ prop }}" class="lh-control pr-1.5 {{ current ? 'border-accent-line bg-accent-tint' }}"
                    data-model="{{ prop }}" {{ values is empty and not current ? 'disabled' }}>
                <option value="">All {{ prop == 'service' ? 'services' : 'environments' }}</option>
                {% for value in values %}
                    <option value="{{ value }}" {{ value == current ? 'selected' }}>{{ value }}</option>
                {% endfor %}
            </select>
        {% endfor %}

        {# Ad-hoc filters, added from the drawer. Each chip is its own remove target. #}
        {% for index, filter in f %}
            <span class="lh-control gap-1.5 border-accent-line bg-accent-tint pr-1.5 text-accent">
                <span class="font-mono text-micro">{{ filter.field }}</span>
                <span class="text-ink-muted">{{ filter.op == 'not_equals' ? 'is not' : 'is' }}</span>
                <span class="max-w-40 truncate font-mono text-micro">{{ filter.value }}</span>
                <button type="button" class="shrink-0 rounded p-0.5 hover:bg-accent-line/40"
                        data-action="live#action" data-live-action-param="removeFilter"
                        data-live-index-param="{{ index }}">
                    {{ ui.icon('close', 'size-3') }}
                    <span class="sr-only">Remove this filter</span>
                </button>
            </span>
        {% endfor %}

        {% if this.hasActiveFilters or q %}
            <button type="button" class="lh-button lh-button-quiet"
                    data-action="live#action" data-live-action-param="reset">
                Reset
            </button>
        {% endif %}
    </div>

    {# --- Results ------------------------------------------------------------ #}
    {% if project %}
        {# No loading="defer": the rows are the page. A skeleton on first paint would
           trade the one thing this screen exists for against a round trip. #}
        {# `key`, not `id`: setting `id` yourself stops Live from assigning the child a
           live id, and its partial re-render then sends back a stub with no id at all,
           which breaks every morph of this parent. `key` is the supported way to say
           "a different question means a different child" — and a different child means
           the cursor stack goes with it. #}
        <twig:LogTable
            key="{{ this.searchKey }}"
            class="min-h-0 flex-1"
            projectId="{{ project.id }}"
            search="{{ q }}"
            :filters="this.effectiveFilters"
            range="{{ range }}"
            from="{{ from }}"
            to="{{ to }}"
            sort="{{ sort }}"
            :columns="columns"
            :refreshMs="refreshMs"
            selectedLog="{{ log }}"
        />
    {% else %}
        <div class="flex flex-1 items-center justify-center px-6">
            <div class="flex max-w-sm flex-col items-center gap-2 text-center">
                <span class="flex size-10 items-center justify-center rounded-full bg-sunken text-ink-faint">
                    {{ ui.icon('projects', 'size-5') }}
                </span>
                <p class="text-md font-medium">No project yet</p>
                <p class="text-body text-ink-muted">
                    Logs are stored per project. Create one, then point your application's LogHub
                    handler at its API key.
                </p>
            </div>
        </div>
    {% endif %}

    {% include 'logs/_drawer.html.twig' with {
        record: this.selectedRecord,
        raw: this.selectedRaw,
        level: this.selectedRecord ? this.severityOf(this.selectedRecord) : null,
        requested: log,
    } only %}
</div>
