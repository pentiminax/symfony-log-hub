{% extends 'base.html.twig' %}

{% block title %}LogHub demo{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .flash-success { color: green; }
</style>

<div class="example-wrapper">
    <h1>LogHub demo</h1>

    {% for message in app.flashes('success') %}
        <p class="flash-success">{{ message }}</p>
    {% endfor %}

    <form method="post" action="{{ path('app_demo_sync') }}">
        <button type="submit">Emit sync log</button>
    </form>

    <form method="post" action="{{ path('app_demo_async') }}">
        <button type="submit">Dispatch async log (messenger)</button>
    </form>
</div>
{% endblock %}
