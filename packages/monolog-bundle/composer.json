{
    "name": "loghub/monolog-bundle",
    "type": "symfony-bundle",
    "description": "Symfony Monolog integration bundle for LogHub log ingestion (spec 03).",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "monolog/monolog": "^3.7",
        "symfony/config": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dependency-injection": "8.1.*",
        "symfony/event-dispatcher": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/http-foundation": "8.1.*",
        "symfony/http-kernel": "8.1.*",
        "symfony/security-core": "8.1.*",
        "symfony/uid": "8.1.*"
    },
    "suggest": {
        "open-telemetry/api": "Adds trace_id/span_id of the active span to each log so LogHub can link logs to traces"
    },
    "require-dev": {
        "open-telemetry/api": "^1.0",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "LogHub\\MonologBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LogHub\\MonologBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
