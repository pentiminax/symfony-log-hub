{
    "name": "loghub/engine-bundle",
    "type": "symfony-bundle",
    "description": "Symfony client bundle for the LogHub engine (projects, API keys, log search).",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "symfony/config": "8.1.*",
        "symfony/dependency-injection": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/http-client-contracts": "^3.6",
        "symfony/http-kernel": "8.1.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "LogHub\\EngineBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LogHub\\EngineBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
